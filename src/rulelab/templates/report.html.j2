{% macro t(en, es) %}<span lang="en">{{ en }}</span><span lang="es">{{ es }}</span>{% endmacro %}
{% macro chip(v) %}<span class="chip v-{{ v }}">{{ t(verdicts[v][0], verdicts[v][1]) }}</span>{% endmacro %}
{% macro bar(b, label) %}
{% if b.ok %}
<svg class="ci" viewBox="0 0 {{ b.w }} 22" width="{{ b.w }}" height="22" role="img" aria-label="{{ label }}">
  <rect x="{{ b.m0 }}" y="3" width="{{ b.m1 - b.m0 }}" height="16" class="ci-margin"/>
  <line x1="{{ b.z }}" x2="{{ b.z }}" y1="1" y2="21" class="ci-zero"/>
  <line x1="{{ b.x0 }}" x2="{{ b.x1 }}" y1="11" y2="11" class="ci-range"/>
  <line x1="{{ b.x0 }}" x2="{{ b.x0 }}" y1="6" y2="16" class="ci-range"/>
  <line x1="{{ b.x1 }}" x2="{{ b.x1 }}" y1="6" y2="16" class="ci-range"/>
  {% if b.xe is not none %}<circle cx="{{ b.xe }}" cy="11" r="3.6" class="ci-est"/>{% endif %}
</svg>
{% else %}<span class="muted">n/a</span>{% endif %}
{% endmacro %}
<!doctype html>
<html lang="en" data-lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>rulelab report · {{ res.file.path }}</title>
<meta name="description" content="Leave-one-out ablation of {{ res.file.path }}: success and cost per rule.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect x='1' y='1' width='22' height='22' rx='6' fill='%235d51d1'/%3E%3Cpath d='M10 5.2v4.6l-3.6 6.9a1.2 1.2 0 0 0 1.1 1.8h9a1.2 1.2 0 0 0 1.1-1.8L14 9.8V5.2M8.9 5.2h6.2' fill='none' stroke='%23fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M8.3 14.3h7.4' fill='none' stroke='%23fff' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script>
(function () {
  var d = document.documentElement, lang = null, theme = null;
  try { lang = localStorage.getItem("rulelab-lang"); theme = localStorage.getItem("rulelab-theme"); } catch (e) {}
  if (!lang) lang = (navigator.language || "en").toLowerCase().indexOf("es") === 0 ? "es" : "en";
  d.setAttribute("data-lang", lang); d.setAttribute("lang", lang);
  if (theme) d.setAttribute("data-theme", theme);
})();
</script>
<style>
:root {
  --accent: #5d51d1; --accent-soft: rgba(93, 81, 209, .10); --tile: #5d51d1; --tile-fg: #ffffff;
  --bg: #ffffff; --surface: #ffffff; --surface-2: #f7f7f9; --border: #e4e4e9;
  --shadow: 0 1px 2px rgba(17, 17, 22, .04), 0 4px 16px rgba(17, 17, 22, .05);
  --fg: #111116; --muted: #5c5d66;
  --ok: #11813c; --ok-soft: rgba(17, 129, 60, .10);
  --warn: #a45e00; --warn-soft: rgba(164, 94, 0, .10);
  --err: #c22826; --err-soft: rgba(194, 40, 38, .09);
  --neutral: #5c5d66; --neutral-soft: rgba(92, 93, 102, .10);
  --sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --accent: #a0a2ff; --accent-soft: rgba(160, 162, 255, .14);
    --bg: #000000; --surface: #0d0d10; --surface-2: #141418; --border: #28282e; --shadow: none;
    --fg: #f4f5f8; --muted: #a3a4ae;
    --ok: #5fd37f; --ok-soft: rgba(95, 211, 127, .13);
    --warn: #f7b83d; --warn-soft: rgba(247, 184, 61, .13);
    --err: #f66d67; --err-soft: rgba(246, 109, 103, .13);
    --neutral: #a3a4ae; --neutral-soft: rgba(163, 164, 174, .13);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --accent: #a0a2ff; --accent-soft: rgba(160, 162, 255, .14);
  --bg: #000000; --surface: #0d0d10; --surface-2: #141418; --border: #28282e; --shadow: none;
  --fg: #f4f5f8; --muted: #a3a4ae;
  --ok: #5fd37f; --ok-soft: rgba(95, 211, 127, .13);
  --warn: #f7b83d; --warn-soft: rgba(247, 184, 61, .13);
  --err: #f66d67; --err-soft: rgba(246, 109, 103, .13);
  --neutral: #a3a4ae; --neutral-soft: rgba(163, 164, 174, .13);
  color-scheme: dark;
}
html[data-lang="es"] [lang="en"], html[data-lang="en"] [lang="es"] { display: none !important; }
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 var(--sans); }
a { color: var(--accent); text-underline-offset: 2px; }
code, .mono, .num { font-family: var(--mono); font-feature-settings: "zero" 0; }
.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.muted { color: var(--muted); }
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
header.top { border-bottom: 1px solid var(--border); }
header.top .wrap { display: flex; align-items: center; gap: 12px; height: 60px; }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 650; font-size: 17px; letter-spacing: -.01em; color: var(--fg); text-decoration: none; }
.brand svg { width: 28px; height: 28px; }
.spacer { flex: 1; }
.toggles { display: flex; gap: 8px; }
.toggle { font: 500 13px/1 var(--sans); color: var(--fg); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; height: 32px; padding: 0 10px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
.toggle:hover { border-color: var(--accent); }
.toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.toggle svg { width: 16px; height: 16px; }
main { padding: 32px 0 56px; }
h1 { font-size: 28px; line-height: 1.2; letter-spacing: -.02em; margin: 0 0 6px; }
h2 { font-size: 19px; letter-spacing: -.01em; margin: 44px 0 6px; }
.lede { color: var(--muted); margin: 0 0 20px; max-width: 72ch; }
.meta { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font-size: 13px; margin-bottom: 24px; }
.meta b { color: var(--fg); font-weight: 500; }
.recorded { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--border); background: var(--accent-soft); border-radius: 10px; padding: 10px 14px; font-size: 13.5px; margin-bottom: 20px; }
.recorded strong { color: var(--accent); }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow); }
.kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
.kpi { padding: 16px 18px; }
.kpi .label { font-size: 12.5px; color: var(--muted); }
.kpi .value { font: 600 26px/1.2 var(--sans); letter-spacing: -.02em; margin: 6px 0 4px; font-variant-numeric: tabular-nums; }
.kpi .sub { font-size: 12.5px; color: var(--muted); }
.notice { margin-top: 16px; border: 1px solid var(--border); border-left: 3px solid var(--warn); border-radius: 10px; background: var(--warn-soft); padding: 12px 16px; font-size: 14px; }
.notice strong { color: var(--warn); }
.chip { display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 2px 10px 2px 8px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
.chip::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
.v-helps { color: var(--ok); background: var(--ok-soft); }
.v-hurts { color: var(--err); background: var(--err-soft); }
.v-no_effect { color: var(--neutral); background: var(--neutral-soft); }
.v-inconclusive { color: var(--warn); background: var(--warn-soft); }
.rules { overflow: hidden; }
.row { display: grid; grid-template-columns: minmax(0, 1fr) 70px 196px 128px 104px 96px; gap: 12px; align-items: center; padding: 12px 18px; border-top: 1px solid var(--border); }
.row.head { border-top: 0; font-size: 12px; color: var(--muted); font-weight: 500; padding-top: 10px; padding-bottom: 10px; background: var(--surface-2); }
.row .r-id { font: 500 12px var(--mono); color: var(--accent); margin-right: 6px; }
.row .r-title { font-weight: 550; }
.row .r-lines { font-size: 12px; color: var(--muted); }
.row .right { text-align: right; }
.effect { display: flex; flex-direction: column; gap: 2px; }
.effect .num { font-size: 12.5px; }
.ci { display: block; max-width: 100%; height: auto; }
.ci-margin { fill: var(--neutral-soft); }
.ci-zero { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 2; }
.ci-range { stroke: var(--accent); stroke-width: 2; stroke-linecap: round; }
.ci-est { fill: var(--accent); }
.mlabel { display: none; }
.axis { display: flex; justify-content: space-between; font: 11px var(--mono); color: var(--muted); width: 168px; }
.file { overflow: hidden; }
.file-head { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--surface-2); font-size: 13px; }
.file-head .mono { font-weight: 500; }
.block { padding: 0 16px; }
.block pre { margin: 0; padding: 4px 0; font: 13px/1.6 var(--mono); white-space: pre-wrap; word-break: break-word; }
.block.fixed pre { color: var(--muted); }
.block.rule { border-left: 3px solid var(--neutral); margin: 8px 12px; padding: 8px 12px; border-radius: 0 8px 8px 0; background: var(--surface-2); }
.block.rule.v-helps { border-left-color: var(--ok); }
.block.rule.v-hurts { border-left-color: var(--err); }
.block.rule.v-inconclusive { border-left-color: var(--warn); }
.block.rule .ann { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; font-size: 12.5px; color: var(--muted); margin-bottom: 4px; background: none; }
.block.rule .ann .r-id { font: 600 12px var(--mono); color: var(--accent); }
.block.rule .chip { background: transparent; padding: 0; }
.block.rule pre { color: var(--fg); }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { text-align: left; padding: 10px 16px; border-top: 1px solid var(--border); }
thead th { border-top: 0; font-size: 12px; font-weight: 500; color: var(--muted); background: var(--surface-2); }
td.num, th.num { text-align: right; }
.tablewrap { overflow-x: auto; }
.method { columns: 2 320px; column-gap: 32px; font-size: 14px; color: var(--muted); }
.method p { margin: 0 0 12px; break-inside: avoid; }
.method b { color: var(--fg); font-weight: 600; }
footer { border-top: 1px solid var(--border); padding: 20px 0 32px; font-size: 13px; color: var(--muted); }
@media (max-width: 900px) {
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .row { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 12px; }
  .row.head { display: none; }
  .row > .c-title { grid-column: 1 / -1; }
  .row > .c-effect { grid-column: 1 / 2; }
  .row > .c-verdict { grid-column: 2 / 3; justify-self: end; align-self: start; }
  .row > .c-tokens, .row > .c-delta, .row > .c-month { text-align: left; font-size: 13px; }
  .row > .c-tokens { grid-column: 1 / -1; grid-row: auto; }
  .mlabel { display: inline; color: var(--muted); font-family: var(--sans); }
  .row .right { text-align: left; }
}
@media (max-width: 560px) {
  .wrap { padding: 0 16px; }
  h1 { font-size: 23px; }
  .kpi { padding: 14px; }
  .kpi .value { font-size: 22px; }
  .toggle .tl { display: none; }
  th, td { padding: 9px 10px; }
  .block.rule { margin: 8px 6px; }
  .block { padding: 0 10px; }
}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="g-rule" viewBox="0 0 24 24">
      <rect x="1" y="1" width="22" height="22" rx="6" fill="var(--tile)"/>
      <path d="M10 5.2v4.6l-3.6 6.9a1.2 1.2 0 0 0 1.1 1.8h9a1.2 1.2 0 0 0 1.1-1.8L14 9.8V5.2M8.9 5.2h6.2" fill="none" stroke="var(--tile-fg)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8.3 14.3h7.4" fill="none" stroke="var(--tile-fg)" stroke-width="2" stroke-linecap="round"/>
    </symbol>
  </defs>
</svg>
<header class="top">
  <div class="wrap">
    <a class="brand" href="https://github.com/diegoperezg7/rulelab"><svg aria-hidden="true"><use href="#g-rule"/></svg>rulelab</a>
    <span class="spacer"></span>
    <div class="toggles">
      <button class="toggle" id="lang" type="button" aria-label="Cambiar idioma / Switch language"><span lang="en">ES</span><span lang="es">EN</span></button>
      <button class="toggle" id="theme" type="button" aria-label="Toggle theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <span class="tl">{{ t("Theme", "Tema") }}</span>
      </button>
    </div>
  </div>
</header>
<main>
<div class="wrap">
  {% if recorded %}
  <div class="recorded" role="note">
    <div>
      <strong>{{ t("Recorded run", "Ejecución grabada") }}</strong> ·
      {{ t("Real results produced with", "Resultados reales obtenidos con") }} <code>rulelab run</code>
      {{ t("on", "el") }} {{ recorded.date }} · rulelab {{ recorded.version }} · {{ recorded.hardware }}.
      {{ t("Nothing below is simulated.", "Nada de lo que sigue es simulado.") }}
    </div>
  </div>
  {% endif %}
  <h1>{{ t("Which rules in", "¿Qué reglas de") }} <code>{{ res.file.path }}</code> {{ t("earn their tokens?", "se ganan sus tokens?") }}</h1>
  <p class="lede">{{ t("Each rule was removed on its own and the agent re-ran the same real tasks. A rule helps if success drops without it; it costs tokens on every model call either way.",
    "Se quitó cada regla por separado y el agente repitió las mismas tareas reales. Una regla ayuda si el acierto baja sin ella; en cualquier caso cuesta tokens en cada llamada al modelo.") }}</p>
  <div class="meta">
    <span>{{ t("Model", "Modelo") }} <b class="mono">{{ res.model }}</b></span>
    <span>{{ t("Tasks", "Tareas") }} <b>{{ res.tasks|length }}</b></span>
    <span>{{ t("Repeats", "Repeticiones") }} <b>{{ res.repeats }}</b></span>
    <span>{{ t("Configurations", "Configuraciones") }} <b>{{ res.configs|length }}</b></span>
    <span>{{ t("Agent runs", "Ejecuciones") }} <b>{{ total_runs }}/{{ planned_runs }}</b></span>
    <span>{{ t("Split by", "Partido por") }} <b>{{ t(res.file.granularity, "sección" if res.file.granularity == "section" else "viñeta") }}</b></span>
    <span>{{ t("Spent", "Gastado") }} <b class="num">{{ res.spent_usd|usd(4) }} USD</b>{% if res.meta.price_source %} <span title="{{ res.meta.cost_method }}">({{ res.meta.price_in_per_mtok }}/{{ res.meta.price_out_per_mtok }} USD {{ t("per 1M tokens in/out", "por 1M tokens entrada/salida") }}, {{ res.meta.price_source }})</span>{% endif %}</span>
    {% if res.meta.engine %}<span>{{ t("Engine", "Motor") }} <b>{{ res.meta.engine }}</b></span>{% endif %}
  </div>

  <section class="kpis" aria-label="Summary">
    <div class="card kpi">
      <div class="label">{{ t("Success with the full file", "Acierto con el fichero completo") }}</div>
      <div class="value">{{ full_rate[0]|pct }}</div>
      <div class="sub num">{{ full_rate[1] }}/{{ full_rate[2] }} {{ t("runs", "ejecuciones") }}</div>
    </div>
    <div class="card kpi">
      <div class="label">{{ t("Success with no file", "Acierto sin fichero") }}</div>
      <div class="value">{{ none_rate[0]|pct if none_rate else "n/a" }}</div>
      <div class="sub">{% if a.whole_file %}{{ t("File effect", "Efecto del fichero") }} <span class="num">{{ a.whole_file.estimate|pp }} pp [{{ a.whole_file.low|pp }}, {{ a.whole_file.high|pp }}]</span>{% endif %}</div>
    </div>
    <div class="card kpi">
      <div class="label">{{ t("File size", "Tamaño del fichero") }}</div>
      <div class="value num">≈{{ "{:,}".format(res.file.tokens) }} <span style="font-size:14px;font-weight:500" class="muted">tok</span></div>
      <div class="sub">{{ t("resent on each of", "reenviado en cada una de") }} ~{{ "%.1f"|format(a.mean_turns) }} {{ t("model calls per run", "llamadas al modelo por ejecución") }}{% if a.whole_file_tokens and a.whole_file_tokens.n %}.
        {{ t("Measured vs no file:", "Medido frente a sin fichero:") }} <span class="num">{{ a.whole_file_tokens.mean|signed_int }} tok/{{ t("run", "ejec.") }}</span>{% endif %}</div>
    </div>
    <div class="card kpi">
      <div class="label">{{ t("Verdicts", "Veredictos") }}</div>
      <div class="value">{{ a.rules|length }} <span style="font-size:14px;font-weight:500" class="muted">{{ t("rules", "reglas") }}</span></div>
      <div class="sub">{% for k, n in a.verdict_counts.items() if n %}{{ n }} {{ t(verdicts[k][0], plural_es[k] if n > 1 else verdicts[k][1]) }}{% if not loop.last %} · {% endif %}{% endfor %}</div>
    </div>
  </section>

  {% if a.floor_or_ceiling == "floor" %}
  <div class="notice" role="note">
    <strong>{{ t("Floor effect.", "Efecto suelo.") }}</strong>
    {{ t("Only", "Solo pasó el") }} {{ a.overall_rate|pct }} {{ t("of all runs passed. This model rarely solves these tasks with or without the file, so success cannot show what a rule does: every verdict below is inconclusive for that reason. The token and cost columns are still real measurements. To learn about success, use a stronger model, more --max-steps or easier tasks.",
      "de todas las ejecuciones. Este modelo casi nunca resuelve estas tareas, con o sin fichero, así que el acierto no puede mostrar qué hace cada regla: por eso todos los veredictos salen no concluyentes. Las columnas de tokens y coste sí son mediciones reales. Para saber algo del acierto, usa un modelo más fuerte, más --max-steps o tareas más fáciles.") }}
  </div>
  {% elif a.floor_or_ceiling == "ceiling" %}
  <div class="notice" role="note">
    <strong>{{ t("Ceiling effect.", "Efecto techo.") }}</strong>
    {{ a.overall_rate|pct }} {{ t("of all runs passed. The tasks are too easy for this model to show what a rule does. The token and cost columns are still real measurements.",
      "de las ejecuciones pasaron. Las tareas son demasiado fáciles para este modelo como para ver qué hace cada regla. Las columnas de tokens y coste sí son mediciones reales.") }}
  </div>
  {% endif %}
  {% if a.low_power %}
  <div class="notice" role="note">
    <strong>{{ t("Small sample.", "Muestra pequeña.") }}</strong>
    {{ t("With", "Con") }} {{ res.tasks|length }} {{ t("tasks and", "tareas y") }} {{ res.repeats }} {{ t("repeats, only large effects can be told apart from noise, so most rules come out inconclusive. That is the honest answer, not a failure: add tasks or repeats before deleting a rule on the strength of this report.",
      "repeticiones solo se distinguen del ruido los efectos grandes, así que la mayoría de reglas salen no concluyentes. Es la respuesta honesta, no un fallo: añade tareas o repeticiones antes de borrar una regla basándote en este informe.") }}
  </div>
  {% endif %}
  {% if res.status != "complete" %}
  <div class="notice" role="note">
    <strong>{{ t("Partial results.", "Resultados parciales.") }}</strong>
    {% if res.status == "budget_exceeded" %}{{ t("The run stopped at the --max-cost budget.", "La ejecución se detuvo al llegar al tope de --max-cost.") }}{% else %}{{ t("The run was interrupted.", "La ejecución se interrumpió.") }}{% endif %}
    {{ total_runs }}/{{ planned_runs }} {{ t("agent runs finished.", "ejecuciones terminadas.") }}
  </div>
  {% endif %}

  <h2>{{ t("Rules", "Reglas") }}</h2>
  <p class="lede">{{ t("Effect on success = success with the full file minus success without the rule, in percentage points, with a 95% bootstrap interval. The shaded band is ±", "Efecto en el acierto = acierto con el fichero completo menos acierto sin la regla, en puntos porcentuales, con intervalo bootstrap del 95 %. La banda sombreada es ±") }}{{ (a.margin * 100)|round|int }} pp: {{ t("an interval entirely inside it counts as no effect.", "un intervalo que cae entero dentro cuenta como sin efecto.") }}</p>
  <div class="card rules">
    <div class="row head">
      <div>{{ t("Rule", "Regla") }}</div>
      <div class="right">{{ t("Tokens", "Tokens") }}</div>
      <div>{{ t("Effect on success", "Efecto en el acierto") }}</div>
      <div>{{ t("Verdict", "Veredicto") }}</div>
      <div class="right">{{ t("Input tok/run", "Tok entrada/ejec.") }}</div>
      <div class="right">{{ t("Per month", "Al mes") }}</div>
    </div>
    {% for item in rules %}{% set r = item.r %}
    <div class="row">
      <div class="c-title"><span class="r-id">{{ r.id }}</span><span class="r-title">{{ r.title }}</span>
        <div class="r-lines">{{ t("lines", "líneas") }} {{ r.start_line }}–{{ r.end_line }}</div></div>
      <div class="c-tokens right num"><span class="mlabel">{{ t("Tokens", "Tokens") }} </span>≈{{ r.tokens }} <span class="muted">({{ (item.share * 100)|round|int }}%)</span></div>
      <div class="c-effect effect">
        {{ bar(item.bar, r.id) }}
        <span class="num">{{ r.success.estimate|pp }} pp <span class="muted">[{{ r.success.low|pp }}, {{ r.success.high|pp }}]</span></span>
      </div>
      <div class="c-verdict">{{ chip(r.success.verdict) }}</div>
      <div class="c-delta right num"><span class="mlabel">{{ t("Input tok/run", "Tok entrada/ejec.") }} </span>{{ r.input_tokens.mean|signed_int }}</div>
      <div class="c-month right num"><span class="mlabel">{{ t("Per month", "Al mes") }} </span>{{ r.monthly_usd|usd }} USD</div>
    </div>
    {% endfor %}
  </div>
  <p class="lede" style="margin-top:12px;font-size:13px">
    {{ t("Tokens are approximate (characters / 4). \"Input tok/run\" is the measured difference in input tokens per run with and without the rule; it also moves when the agent takes a different path. \"Per month\" is the rule's tokens × model calls per run ×",
      "Los tokens son aproximados (caracteres / 4). «Tok entrada/ejec.» es la diferencia medida de tokens de entrada por ejecución con y sin la regla; también cambia cuando el agente toma otro camino. «Al mes» es tokens de la regla × llamadas al modelo por ejecución ×") }}
    {{ "{:,}".format(a.sessions_per_month) }} {{ t("sessions at", "sesiones a") }} {{ a.price_in }} USD / 1M tok ({{ a.price_label }}){{ t(", without prompt caching.", ", sin caché de prompt.") }}
    {{ t("The whole file:", "El fichero entero:") }} <span class="num">{{ file_monthly|usd }} USD</span>.
  </p>

  <h2>{{ t("Annotated file", "Fichero anotado") }}</h2>
  <p class="lede">{{ t("Every rule as it appears in the file, with its verdict. Grey lines are kept in every configuration.", "Cada regla tal como aparece en el fichero, con su veredicto. Las líneas en gris se mantienen en todas las configuraciones.") }}</p>
  <div class="card file">
    <div class="file-head"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><span class="mono">{{ res.file.path }}</span><span class="muted">≈{{ "{:,}".format(res.file.tokens) }} tok</span></div>
    {% for b in blocks %}
    {% if b.rule %}{% set r = b.rule %}
    <div class="block rule v-{{ r.success.verdict }}" id="{{ r.id }}">
      <div class="ann"><span class="r-id">{{ r.id }}</span>{{ chip(r.success.verdict) }}<span class="num">{{ r.success.estimate|pp }} pp [{{ r.success.low|pp }}, {{ r.success.high|pp }}]</span><span class="num">≈{{ r.tokens }} tok</span></div>
      <pre>{{ b.text }}</pre>
    </div>
    {% else %}
    <div class="block fixed"><pre>{{ b.text }}</pre></div>
    {% endif %}
    {% endfor %}
  </div>

  <h2>{{ t("Configurations", "Configuraciones") }}</h2>
  <p class="lede">{{ t("Raw success per configuration, pooled over tasks.", "Acierto bruto por configuración, sumando todas las tareas.") }}</p>
  <div class="card tablewrap">
    <table>
      <thead><tr><th>{{ t("Configuration", "Configuración") }}</th><th class="num">{{ t("Success", "Acierto") }}</th><th class="num">{{ t("Runs", "Ejec.") }}</th><th class="num">{{ t("Input tok/run", "Tok entrada/ejec.") }}</th><th class="num">USD/{{ t("run", "ejec.") }}</th></tr></thead>
      <tbody>
      {% for c in configs %}
        <tr>
          <td>{% if c.id == "none" %}{{ t("No file", "Sin fichero") }}{% elif c.id == "full" %}{{ t("Full file", "Fichero completo") }}{% else %}{{ t("Without", "Sin") }} <span class="mono">{{ c.removed }}</span>{% endif %}</td>
          <td class="num">{{ c.rate|pct }} <span class="muted">({{ c.s }}/{{ c.n }})</span></td>
          <td class="num">{{ c.n }}/{{ c.planned }}</td>
          <td class="num">{{ "{:,.0f}".format(c.tokens) if c.tokens == c.tokens else "n/a" }}</td>
          <td class="num">{{ c.cost|usd(4) }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% if a.errors %}<p class="lede" style="margin-top:10px;font-size:13px">{{ a.errors }} {{ t("runs ended in an infrastructure error and are excluded from the statistics.", "ejecuciones acabaron en error de infraestructura y no cuentan en la estadística.") }}</p>{% endif %}

  <h2>{{ t("Method", "Método") }}</h2>
  <div class="method">
    <p><b>{{ t("Leave-one-out.", "Quitar de una en una.") }}</b> {{ t("Configurations: no file, the full file, and the full file minus each rule. Every configuration runs the same tasks the same number of times, in an interleaved order so a partial run stays balanced.",
      "Configuraciones: sin fichero, fichero completo y fichero completo sin cada regla. Todas corren las mismas tareas el mismo número de veces, en orden intercalado para que una ejecución parcial siga equilibrada.") }}</p>
    <p><b>{{ t("Real tasks.", "Tareas reales.") }}</b> {{ t("Tasks come from commits of the repository and are scored by its own tests, run inside a Docker sandbox with no network. The model is called from the host.",
      "Las tareas salen de commits del repositorio y se puntúan con sus propios tests, dentro de un sandbox Docker sin red. El modelo se llama desde el host.") }}</p>
    <p><b>{{ t("Interval.", "Intervalo.") }}</b> {{ t("Two-level bootstrap: tasks are resampled with replacement and each configuration's per-task success rate is drawn from a Beta(s+½, f+½) posterior, so 3/3 vs 3/3 does not read as certainty.",
      "Bootstrap en dos niveles: se remuestrean tareas con reemplazo y el acierto por tarea de cada configuración se saca de una posterior Beta(s+½, f+½), para que 3/3 frente a 3/3 no parezca una certeza.") }}</p>
    <p><b>{{ t("Verdict.", "Veredicto.") }}</b> {{ t("Helps if the whole interval is above 0, hurts if below 0, no effect if it sits inside ±", "Ayuda si todo el intervalo está por encima de 0, empeora si está por debajo, sin efecto si cabe dentro de ±") }}{{ (a.margin * 100)|round|int }} pp, {{ t("inconclusive otherwise.", "y no concluyente en otro caso.") }}</p>
    <p><b>{{ t("Why measure.", "Por qué medir.") }}</b> {{ t("Gloaguen et al. (ETH Zurich, LogicStar.ai) found that context files do not generally improve task success while raising inference cost by over 20% on average.", "Gloaguen et al. (ETH Zúrich, LogicStar.ai) vieron que los ficheros de contexto no mejoran en general el acierto y suben el coste de inferencia más de un 20 % de media.") }} <a href="https://arxiv.org/abs/2602.11988">arXiv 2602.11988</a></p>
  </div>
</div>
</main>
<footer>
  <div class="wrap">
    {{ t("Generated by", "Generado por") }} <a href="https://github.com/diegoperezg7/rulelab">rulelab</a> {{ version }} · {{ res.created }}{% if res.meta.platform %} · {{ res.meta.platform }}{% endif %}
  </div>
</footer>
<script>
(function () {
  var d = document.documentElement;
  function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  document.getElementById("lang").addEventListener("click", function () {
    var next = d.getAttribute("data-lang") === "es" ? "en" : "es";
    d.setAttribute("data-lang", next); d.setAttribute("lang", next); save("rulelab-lang", next);
  });
  document.getElementById("theme").addEventListener("click", function () {
    var cur = d.getAttribute("data-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    var next = cur === "dark" ? "light" : "dark";
    d.setAttribute("data-theme", next); save("rulelab-theme", next);
  });
})();
</script>
</body>
</html>
